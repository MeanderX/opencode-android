#!/data/data/com.termux/files/usr/bin/bash
# oc — launch OpenCode inside its Linux environment (Termux + proot-distro)
#
# Usage:
#   oc                OpenCode in the last used project (or ~/projects)
#   oc my-project     OpenCode in ~/projects/my-project (created if missing)
#   oc /some/dir      OpenCode in an explicit directory
#   oc run "prompt"   one-off prompt, passed straight through to opencode
#   oc shell          drop into the Linux environment itself
#
# Anything that is not a project directory is passed through to opencode,
# so every opencode flag and subcommand works: oc --version, oc mini,
# oc auth login, ...

set -euo pipefail

DISTRO="${OPENCODE_DISTRO:-debian}"
PROJECTS="$HOME/projects"
CONFIG_DIR="$HOME/.config/oc"
CONFIG="$CONFIG_DIR/config"
LASTFILE="$CONFIG_DIR/last-project"

# --- proot-distro launch options ---------------------------------------------
# Newer proot-distro binds the Termux home, shared storage and the Termux
# $PREFIX by default; older versions do not. install.sh records the right
# choice in $CONFIG (BIND_HOME=1 adds an explicit home bind).
PD_ARGS=(--shared-tmp)
BIND_HOME=1
if [ -f "$CONFIG" ]; then
    # shellcheck disable=SC1090
    . "$CONFIG"
fi
if [ "$BIND_HOME" = "1" ]; then
    PD_ARGS+=(--bind "$HOME:$HOME")
fi

# The auto-update helper below runs inside the environment, where $HOME is
# the Linux user's home and not the Termux one. Hand it the Termux config
# directory explicitly so both sides agree on where state is kept.
PD_ARGS+=(-e "OC_CONFIG_DIR=$CONFIG_DIR")

# Forward API keys set in Termux into the environment — proot-distro does not
# carry the host environment in. (Signing in inside OpenCode via
# `oc auth login` is the alternative and persists in the environment.)
for v in ANTHROPIC_API_KEY OPENAI_API_KEY GEMINI_API_KEY OPENROUTER_API_KEY \
         GROQ_API_KEY XAI_API_KEY MISTRAL_API_KEY DEEPSEEK_API_KEY; do
    val="${!v:-}"
    if [ -n "$val" ]; then
        PD_ARGS+=(-e "$v=$val")
    fi
done

# --- work out what to launch ---------------------------------------------------

if [ $# -gt 0 ] && [ "$1" = "shell" ]; then
    exec proot-distro login "$DISTRO" "${PD_ARGS[@]}" -- /bin/bash -l
fi

workdir=""
if [ $# -gt 0 ] && [ "$1" != "run" ]; then
    if [ -d "$PROJECTS/$1" ]; then
        workdir="$PROJECTS/$1"
        shift
    elif [ -d "$1" ]; then
        workdir="$(cd "$1" && pwd)"
        shift
    else
        # Not an existing directory. A plain name (no slash, no leading dot,
        # not a flag) is offered as a new project, so `oc my-app` works on a
        # fresh phone. Anything starting with "-" is an opencode flag and is
        # passed straight through.
        case "$1" in
            -*|*/*|.*) ;;
            *)
                printf 'Create project %s and open it? [y/N] ' "$1"
                answer=""
                read -r answer || true
                case "$answer" in
                    [yY]*)
                        mkdir -p "$PROJECTS/$1"
                        workdir="$PROJECTS/$1"
                        shift
                        ;;
                esac
                ;;
        esac
    fi
fi

if [ -z "$workdir" ]; then
    case "$PWD" in
        "$HOME"|"$HOME"/*) workdir="$PWD" ;;
    esac
fi
if [ -z "$workdir" ] && [ -f "$LASTFILE" ]; then
    last="$(cat "$LASTFILE" 2>/dev/null || true)"
    if [ -d "$last" ]; then
        workdir="$last"
    fi
fi
if [ -z "$workdir" ]; then
    workdir="$PROJECTS"
fi
if [ ! -d "$workdir" ]; then
    workdir="$PROJECTS"
fi

mkdir -p "$PROJECTS" "$(dirname "$LASTFILE")"
printf '%s\n' "$workdir" > "$LASTFILE"

# --- launch ---------------------------------------------------------------------
# Everything is quoted so paths and prompts with spaces stay intact.
args_q=""
if [ $# -gt 0 ]; then
    printf -v args_q ' %q' "$@"
fi

# Update handling runs inside the environment, in the same proot session, so
# there is no second login to pay for. It costs nothing on most launches: the
# daily stamp short-circuits before anything is executed.
read -r -d '' AUTOUPDATE <<'GUEST' || true
# OpenCode's npm postinstall hard-links the platform binary into place, and
# proot hard-links it again into /.l2s when it runs (its --link2symlink
# option). Any file with more than one link is therefore executed from that
# synthetic path, so process.execPath stops pointing at the npm package,
# OpenCode cannot find the package.json above itself, and it decides it has
# no install method — `/update` then fails with "installation method not
# found". Copying to a fresh inode drops the link count back to 1.
# The stat costs nothing, so this also repairs the binary after an update,
# including one run from inside OpenCode itself.
oc_repair_binary() {
    local oc_bin oc_tmp oc_real oc_nlink repaired=1
    for oc_bin in /usr/local/lib/node_modules/@opencode/cli/bin/opencode*; do
        [ -e "$oc_bin" ] || [ -L "$oc_bin" ] || continue
        # Healthy means a plain file with a single link. proot replaces the
        # path with a symlink into /.l2s once the file is multi-linked, so a
        # symlink here means the hijack already happened. stat must follow
        # the link (-L): stat without it reports the symlink's own count.
        if [ ! -L "$oc_bin" ] && [ -f "$oc_bin" ]; then
            oc_nlink="$(stat -L -c %h "$oc_bin" 2>/dev/null || echo 1)"
            [ "$oc_nlink" = "1" ] && continue
        fi
        oc_real="$(readlink -f "$oc_bin" 2>/dev/null || true)"
        if [ -z "$oc_real" ] || [ ! -f "$oc_real" ]; then
            # Dangling pointer into /.l2s — drop it so nothing resolves there.
            printf '\033[1;33m[oc]\033[0m Removing stale OpenCode link; reinstall needed.\n'
            rm -f "$oc_bin"
            repaired=0
            continue
        fi
        printf '\033[1;36m[oc]\033[0m Repairing OpenCode binary link...\r'
        oc_tmp="$oc_bin.repair.$$"
        # Copy the real content, then clear the path before moving into it:
        # renaming over the proot symlink fails with EPERM.
        if cp -L "$oc_bin" "$oc_tmp" 2>/dev/null; then
            rm -f "$oc_bin"
            mv "$oc_tmp" "$oc_bin" 2>/dev/null || cp "$oc_tmp" "$oc_bin" 2>/dev/null
            chmod 755 "$oc_bin" 2>/dev/null
            rm -f "$oc_tmp"
        else
            rm -f "$oc_tmp"
        fi
        repaired=0
        printf '\033[1;36m[oc]\033[0m OpenCode binary link repaired.\r'
    done
    return $repaired
}

# A service started before the repair is still running from /.l2s, and it
# is that process which runs /update — so it has to be recycled too.
if ! oc_repair_binary; then
    opencode2 service restart >/dev/null 2>&1 || true
fi

oc_repair_binary

# Atomic, verified update. Installing straight over the live copy is what makes
# a bad build (or a half-run postinstall) brick the launcher. Instead: install
# the target version into a throwaway prefix, prove the new binary runs and
# reports the expected version, and only then swap it in. Any failure along the
# way leaves the current install exactly as it was.
oc_staged_update() {
    local want="$1" stage staged live tmp got
    stage="$(mktemp -d "${TMPDIR:-/tmp}/opencode-stage.XXXXXX" 2>/dev/null)" || return 1

    if ! timeout "${OC_UPDATE_TIMEOUT:-1800}" \
        npm install --prefix "$stage" --force --no-save --no-package-lock \
        "@opencode/cli@$want" >/dev/null 2>&1
    then
        rm -rf "$stage" 2>/dev/null || true
        return 1
    fi
    if [ ! -e "$stage/node_modules/@opencode/cli" ] && [ ! -L "$stage/node_modules/@opencode/cli" ]; then
        rm -rf "$stage" 2>/dev/null || true
        return 1
    fi

    staged="$stage/node_modules/@opencode/cli/bin/opencode.exe"
    if [ ! -e "$staged" ] && [ ! -L "$staged" ]; then
        rm -rf "$stage" 2>/dev/null || true
        return 1
    fi

    # Gate the swap on the new binary actually working.
    # The binary prints "opencode v2.1.0"; older builds print "1.19.3".
    # Take the last whitespace-separated token so both parse to a bare version.
    got="$(timeout 60 "$staged" --version 2>/dev/null | head -n1 \
        | tr ' ' '\n' | tail -n1 | sed 's/^v//')"
    if [ "$got" != "$want" ]; then
        rm -rf "$stage" 2>/dev/null || true
        return 1
    fi

    # Verified. Swap it in: build a fresh single-link file, then atomically
    # rename it over the live binary. (Renaming over a proot /.l2s symlink
    # fails with EPERM, so clear the path first.)
    live="/usr/local/lib/node_modules/@opencode/cli"
    tmp="$live/bin/opencode.exe.stage.$$"
    if ! cp -L "$staged" "$tmp" 2>/dev/null; then
        rm -rf "$stage" "$tmp" 2>/dev/null || true
        return 1
    fi
    chmod 755 "$tmp" 2>/dev/null || true
    rm -f "$live/bin/opencode.exe" 2>/dev/null || true
    mv "$tmp" "$live/bin/opencode.exe" 2>/dev/null \
        || cp "$tmp" "$live/bin/opencode.exe" 2>/dev/null
    # Keep `npm list -g` (install-method detection) reporting the new version.
    cp "$stage/node_modules/@opencode/cli/package.json" "$live/package.json" 2>/dev/null || true

    rm -rf "$stage" 2>/dev/null || true

    # Single link now, so this is a no-op; recycle the service so the fresh
    # binary is what serves sessions.
    oc_repair_binary || true
    opencode2 service restart >/dev/null 2>&1 || true
    return 0
}

if [ "${OC_NO_AUTOUPDATE:-}" != "1" ]; then
    oc_state="${OC_CONFIG_DIR:-$HOME/.config/oc}"
    oc_stamp="$oc_state/last-update-check"
    oc_now="$(date +%s 2>/dev/null || echo 0)"
    oc_last="$(cat "$oc_stamp" 2>/dev/null || echo 0)"
    case "$oc_last" in ''|*[!0-9]*) oc_last=0 ;; esac
    case "$oc_now" in ''|*[!0-9]*) oc_now=0 ;; esac
    if [ "$oc_now" -gt 0 ] && [ $((oc_now - oc_last)) -ge "${OC_UPDATE_INTERVAL:-86400}" ]; then
        mkdir -p "$oc_state" 2>/dev/null || true
        # Stamp before updating so a failure retries tomorrow, not every launch.
        printf '%s\n' "$oc_now" > "$oc_stamp" 2>/dev/null || true

        oc_have="$(opencode2 --version 2>/dev/null | head -n1 \
            | tr ' ' '\n' | tail -n1 | sed 's/^v//')"
        oc_want="$(curl -fsSL --max-time "${OC_UPDATE_CHECK_TIMEOUT:-20}" \
            'https://registry.npmjs.org/@opencode%2Fcli/latest' 2>/dev/null \
            | sed -n 's/.*"version":"\([^"]*\)".*/\1/p' | head -n1)"
        [ -n "$oc_want" ] || oc_want="$(npm view @opencode/cli version 2>/dev/null | tail -n1)"

        case "$oc_want" in
            [0-9]*)
                if [ "$oc_want" != "$oc_have" ]; then
                    printf '\033[1;36m[oc]\033[0m Updating OpenCode %s -> %s\n' "${oc_have:-unknown}" "$oc_want"
                    if oc_staged_update "$oc_want"; then
                        printf '\033[1;32m[oc]\033[0m Updated to OpenCode %s\n' "$oc_want"
                    else
                        printf '\033[1;33m[oc]\033[0m Update failed — keeping %s\n' "${oc_have:-current}"
                    fi
                fi
                ;;
            *)
                # Offline or registry unreachable: stay quiet and carry on.
                ;;
        esac
    fi
fi
GUEST

cmd="$AUTOUPDATE"$'\n'"cd $(printf '%q' "$workdir") && exec opencode2$args_q"

exec proot-distro login "$DISTRO" "${PD_ARGS[@]}" -- /bin/bash -lc "$cmd"
